{
  "name": "@thydda/web-components",
  "version": "0.2.3",
  "description": "Reusable framework-independent Web Components built with Lit.",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run check",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node scripts/check-component-tests.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:merge && npm run test:unit && npm run build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "npm test",
    "merge:main": "node scripts/merge-main.mjs",
    "test:merge": "node --test scripts/merge-main.test.mjs"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.7",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thydda/web-components.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
